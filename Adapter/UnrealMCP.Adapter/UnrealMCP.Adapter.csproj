<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>UnrealMCP.Adapter</RootNamespace>
    <AssemblyName>UnrealMCP.Adapter</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UnrealMCP.Adapter.RegressionTests" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.8" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup Condition="Exists('unreal-tools.json')">
    <None Include="unreal-tools.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
